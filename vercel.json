{
  "functions": {
    "api/webhook.js": {
      "maxDuration": 60
    },
    "api/broadcast.js": {
      "maxDuration": 60
    },
    "api/notify-recipe.js": {
      "maxDuration": 60
    },
    "api/cron-daily-reminder.js": {
      "maxDuration": 60
    },
    "api/cron-weekly-reminder.js": {
      "maxDuration": 60
    },
    "api/ai-chat.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron-daily-reminder?meal=lunch",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron-daily-reminder?meal=dinner",
      "schedule": "30 11 * * *"
    },
    {
      "path": "/api/cron-weekly-reminder",
      "schedule": "0 3 * * 1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://web.telegram.org https://*.telegram.org;" }
      ]
    }
  ]
}
